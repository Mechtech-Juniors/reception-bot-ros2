<?xml version="1.0"?>
<sdf version="1.6">
  <world name="office_world">

    <gravity>0 0 -9.81</gravity>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- North wall -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>20 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>20 0.2 3.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="south_wall">
      <static>true</static>
      <pose>0 -10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>20 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>20 0.2 3.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="east_wall">
      <static>true</static>
      <pose>10 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 20 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 20 3.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="west_wall">
      <static>true</static>
      <pose>-10 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 20 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 20 3.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Reception desk -->
    <model name="reception_desk">
      <static>true</static>
      <pose>0 7 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>3.0 1.0 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>3.0 1.0 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Divider 1 -->
    <model name="divider_1">
      <static>true</static>
      <pose>-2.5 3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>5.0 0.1 1.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>5.0 0.1 1.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.9 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Divider 2 -->
    <model name="divider_2">
      <static>true</static>
      <pose>2.5 -3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>5.0 0.1 1.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>5.0 0.1 1.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.9 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Waiting table -->
    <model name="waiting_table">
      <static>true</static>
      <pose>-6 6 0.375 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.2 0.6 0.75</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Pillar 1 -->
    <model name="pillar_1">
      <static>true</static>
      <pose>5 5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Pillar 2 -->
    <model name="pillar_2">
      <static>true</static>
      <pose>-5 5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>